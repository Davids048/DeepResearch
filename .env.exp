# =============================================================================
# Model and Inference Hyperparameters
# =============================================================================
# MODEL_PATH=Qwen/Qwen3-235B-A22B-Thinking-2507
# MODEL_PATH=openai/gpt-oss-120b
# MODEL_PATH=MiniMaxAI/MiniMax-M2
# MODEL_PATH=Alibaba-NLP/Tongyi-DeepResearch-30B-A3B
MODEL_PATH=zai-org/GLM-4.6
DATASET=browsecomp
OUTPUT_PATH=debug_output
# OUTPUT_PATH=output
ROLLOUT_COUNT=1 # Default=3, set to 1 for debug
MAX_WORKERS=3 # Default=30, set to 1 for debug

# Inference Runtime Configuration
VLLM_PORT=6000          # Port where vLLM model server is running
DEBUG_SIZE=3     # Debug mode: 0=disabled, >0=limit to N samples
MAX_LLM_CALL_PER_RUN=3    # Default 100  Debug 10

# EVOLVE configs
RUN_MODE=evolve_kflow         # Mode: 'baseline' or 'evolve' or 'evolve_kflow'
MAX_ITERATIONS=3        # Maximum evolution iterations for evolver (default: 3)
MAX_REFLECTIONS=2

TEMPERATURE=1
PRESENCE_PENALTY=1.1

######################################
###          Setup wandb           ###
######################################
WANDB_PROJECT="deepresearch-evolve"
WANDB_NAME="$MODEL_PATH-${DATASET}-nroll${ROLLOUT_COUNT}"
WANDB_NOTES="debug glm evolve kflow"
# WANDB_NOTES="Baseline"
# WANDB_MODE=disabled # comment this out for default wandb behavior

# =============================================================================
